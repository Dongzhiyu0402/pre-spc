# 环境变量模板（复制为 .env 后按需修改）
# 复制：cp .env.example .env

# Postgres
POSTGRES_USER=pre
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=pre_spc

# JWT 密钥（生产必须替换为 32+ 字节随机串）
PRE_JWT_SECRET=please-change-me-to-a-long-random-secret-string

# CORS 允许的前端域名（逗号分隔）
PRE_CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# 用量配置（可选，默认见 app/config.py）
# PRE_REGISTER_FREE_QUOTA=5
# PRE_CHECK_COST_POINTS=1
# PRE_CALIBRATION_REWARD_POINTS=2
